<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <Product>Cats Compression</Product>
    <AssemblyTitle>Cats Compression</AssemblyTitle>
    <!-- Release builds override this with the version from the git tag (v1.2.3 -> 1.2.3). -->
    <Version>1.0.0</Version>
    <Authors>Mohammad Usman</Authors>
    <Copyright>Copyright (c) 2025 Mohammad Usman</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <!-- The same icon, embedded so the window can show it in its title bar. -->
    <EmbeddedResource Include="app.ico" LogicalName="app.ico" />
  </ItemGroup>

</Project>